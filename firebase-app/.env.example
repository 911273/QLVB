# Firebase Web App config.
# Copy file này thành `.env` rồi điền giá trị lấy từ:
#   Firebase Console > Project settings > General > Your apps > Web app > SDK setup and configuration
#
# LƯU Ý: Các giá trị này KHÔNG phải bí mật (chúng đi kèm client web),
# nhưng vẫn không commit `.env` để dễ quản lý theo môi trường.
#
# Project number của bạn: 560640156221  (chính là MESSAGING_SENDER_ID bên dưới).
# Bạn vẫn cần điền các giá trị còn lại sau khi đăng ký web app (xem README).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=560640156221
VITE_FIREBASE_APP_ID=

# (Tùy chọn) URL Web App QLVB (Apps Script) nhúng vào module Quản lý văn bản.
# Bỏ trống sẽ dùng URL mặc định trong src/config.js.
VITE_QLVB_EXEC_URL=
